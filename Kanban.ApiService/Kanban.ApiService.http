@Api_HostAddress = http://localhost:5526
@projectId = 00000000-0000-0000-0000-000000000000
@columnId = 11111111-1111-1111-1111-111111111111
@taskId = 22222222-2222-2222-2222-222222222222

### Get all projects
GET {{Api_HostAddress}}/api/projects/
Accept: application/json

### Get a project by id
GET {{Api_HostAddress}}/api/projects/{{projectId}}
Accept: application/json

### Create a project
POST {{Api_HostAddress}}/api/projects/
Content-Type: application/json

{
  "name": "New Project"
}

### Add a column to a project
POST {{Api_HostAddress}}/api/projects/{{projectId}}/columns
Content-Type: application/json

{
  "name": "Review",
  "order": 3
}

### Update a column
PUT {{Api_HostAddress}}/api/projects/{{projectId}}/columns/{{columnId}}
Content-Type: application/json

{
  "name": "In Review",
  "order": 1
}

### Add a task to a column
POST {{Api_HostAddress}}/api/projects/{{projectId}}/columns/{{columnId}}/tasks
Content-Type: application/json

{
  "name": "Refine backlog",
  "description": "Break the work into smaller items"
}

### Update a task
PUT {{Api_HostAddress}}/api/projects/{{projectId}}/columns/{{columnId}}/tasks/{{taskId}}
Content-Type: application/json

{
  "name": "Refine backlog and estimates",
  "description": "Break the work into smaller items and size them"
}

### Example 404 response
GET {{Api_HostAddress}}/api/projects/11111111-1111-1111-1111-111111111111
Accept: application/json

###
